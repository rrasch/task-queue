#!/bin/bash
#
# task-queue	Start up Task Queue
#
# chkconfig: 2345 99 01
# description: Task Queue runs jobs in parallel.

set -e
set -u

HOST=$(hostname -s)
if [[ $HOST =~ ^d ]]; then
	ENV=dev
else
	ENV=prod
fi

# Clear environment and read values from config file. We don't
# unset FOREGROUND because we set this in systemd service file
unset TQHOME TQUSER PIDFILE LOGDIR LOG_LEVEL MQHOST \
      USE_CGROUP MIN_WORKERS MAX_WORKERS RVM_RUBY_VERSION

CONFIG_FILE=/content/$ENV/rstar/etc/task-queue.sysconfig

if [ -f "$CONFIG_FILE" ]; then
	# shellcheck disable=SC1090
	. "$CONFIG_FILE"
fi

TQHOME=${TQHOME:-/usr/local/dlib/task-queue}

TQUSER=${TQUSER:-rstar}

PIDFILE=${PIDFILE:-/var/lib/task-queue/taskqueueserver.pid}

LOGDIR=${LOGDIR:-/content/$ENV/rstar/tmp/mdi/task-queue/logs}

LOG_LEVEL=${LOG_LEVEL:-info}

MQHOST=${MQHOST:-localhost}

USE_CGROUP=${USE_CGROUP:-true}

FOREGROUND=${FOREGROUND:-false}

MIN_WORKERS=${MIN_WORKERS:-}

MAX_WORKERS=${MAX_WORKERS:-}

RVM_RUBY_VERSION=${RVM_RUBY_VERSION:-}

RVM_GEM_DIR="/usr/share/rvm/gems"

RETVAL=0


log() {
	local msg="$*"
	# logger -t task-queue -p user.info -- "$msg"
	echo "$msg" 1>&2
}


abort() {
    echo "$*" 1>&2
    exit 1
}


get_cgroup_version() {
	case "$(stat -fc %T /sys/fs/cgroup 2>/dev/null)" in
		cgroup2fs) echo "v2" ;;
		tmpfs)     echo "v1" ;;
		*)         echo "none" ;;
	esac
}


has_cpu_quota() {
	local quota
	quota=$(systemctl show task-queue --property=CPUQuotaPerSecUSec --value)
	if [[ -n "$quota" && "$quota" != "infinity" ]]; then
		return 0
	else
		return 1
	fi
}


set_cpu_quota() {
    local service=task-queue
    local percentage=${1:-75}

    local num_cores
    num_cores=$(nproc)

    local target_quota=$((num_cores * percentage / 100 * 100))
    (( target_quota < 100 )) && target_quota=100

    echo "Detected ${num_cores} cores. Setting CPUQuota to ${target_quota}%."
    systemctl set-property --runtime "$service" CPUQuota="${target_quota}%"

    local current_quota
    current_quota=$(systemctl show "$service" -p CPUQuotaPerSecUSec)
    echo "Systemd now reports $current_quota"
}


start() {
	PIDS=$(pgrep -f 'ruby.*workers.rb' | paste -sd' ')
	if [ -n "$PIDS" ]; then
		abort "Task Queue already running with pids '$PIDS'"
	fi

	if [ "$TQUSER" = "root" ]; then
		abort "Choose a non-root user to run task queue."
	fi

	HOST_LOGDIR="$LOGDIR/$HOST"
	LOGFILE=$HOST_LOGDIR/worker.$HOST.log
	if [ ! -e "$HOST_LOGDIR" ]; then
		mkdir -m 0755 "$HOST_LOGDIR"
	fi

	CMD=()

	CGROUP_VERSION=$(get_cgroup_version)

	SLICE_FILE=/etc/systemd/system/rstar.slice

	if [ "$USE_CGROUP" = "true" ]; then

		if [ "$CGROUP_VERSION" = "none" ]; then
			abort "Please enable cgroups."
		fi

		if [ ! -f "$SLICE_FILE" ]; then
			set_cpu_quota
		else
			if ! has_cpu_quota; then
				abort "$SLICE_FILE exits but quota not set"
			fi
		fi

	fi

	if [ -n "$RVM_RUBY_VERSION" ]; then
		CMD+=("$RVM_GEM_DIR/ruby-$RVM_RUBY_VERSION@task-queue/wrappers/ruby")
	fi
	CMD+=("$TQHOME/workers.rb" -m "$MQHOST" -l "$LOGFILE" -p "$PIDFILE")
	if [ -n "$LOG_LEVEL" ]; then
		CMD+=(--log-level "$LOG_LEVEL")
	fi
	if [ "$FOREGROUND" = "true" ]; then
		CMD+=(-f)
	fi
	if [ -n "$MIN_WORKERS" ]; then
		CMD+=(-n "$MIN_WORKERS")
	fi
	if [ -n "$MAX_WORKERS" ]; then
		CMD+=(-x "$MAX_WORKERS")
	fi

	printf -v CMD_STR '%q ' "${CMD[@]}"
	CMD_STR="${CMD_STR%" "}"
	if [[ "$CMD_STR" =~ [\;\&\|\`\<\>\$\(] ]]; then
		abort "Unsafe characters in command"
	fi

	log "Running '$CMD_STR' as uid $UID"

	if [ "$TQUSER" = "$(whoami)" ]; then
		exec "${CMD[@]}"
	else
		TQGROUP=$(id -gn "$TQUSER")
		chown "${TQUSER}:${TQGROUP}" "$HOST_LOGDIR"
		if [ -f "$LOGFILE" ]; then
			chown "${TQUSER}:${TQGROUP}" "$LOGFILE"
		fi
		su -ls /bin/bash "$TQUSER" -c 'exec "$@"' -- _ "${CMD[@]}"
	fi
	RETVAL=$?
}

stop() {
	if [ -f "$PIDFILE" ]; then
		kill "$(cat "$PIDFILE")"
		RETVAL=$?
	fi
}

restart() {
	stop
	sleep 5
	start
}

reload() {
	if [ -f "$PIDFILE" ]; then
		kill -HUP "$(cat "$PIDFILE")"
		RETVAL=$?
	fi
}

case "${1:-}" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		restart
		;;
	reload)
		reload
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}" >&2
		exit 3
		;;
esac

exit $RETVAL
